<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <AssemblyName>AgVerse</AssemblyName>
    <RootNamespace>AgVerse</RootNamespace>
    <Product>AgVerse</Product>
    <Title>AgVerse - Multi-Profile Manager for Antigravity</Title>
    <Version>2.0.2</Version>
    <Description>Multi-Profile Manager &amp; Workspace Isolation for Google Antigravity</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\github_16.png" Link="Resources\github_16.png" />
    <EmbeddedResource Include="..\..\github_20.png" Link="Resources\github_20.png" />
    <EmbeddedResource Include="..\..\github_24.png" Link="Resources\github_24.png" />
    <EmbeddedResource Include="..\..\github_32.png" Link="Resources\github_32.png" />
    <EmbeddedResource Include="..\..\icon.ico" Link="Resources\icon.ico" />
  </ItemGroup>

</Project>
